<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by the quick-panel pills and round buttons: frosted at rest, solid white
     on focus, the way tvOS marks the selected control. The corner radius is large
     enough to turn any 48dp control into a capsule or a circle. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/white" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/glass_fill" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
</selector>
