<?xml version="1.0" encoding="utf-8"?>
<!-- Two stacked images so the slideshow can crossfade from one to the next. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:id="@+id/dreamWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/dreamWallpaperNext"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_bottom" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="64dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dreamClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="76sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:shadowColor="#B3000000"
            android:shadowRadius="18"
            android:shadowDx="0"
            android:shadowDy="3" />

        <TextView
            android:id="@+id/dreamDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="21sp"
            android:shadowColor="#B3000000"
            android:shadowRadius="14"
            android:shadowDx="0"
            android:shadowDy="2" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dreamCredit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="64dp"
        android:orientation="vertical"
        android:gravity="end"
        android:visibility="gone">

        <TextView
            android:id="@+id/dreamArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="460dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:shadowColor="#B3000000"
            android:shadowRadius="8" />

        <TextView
            android:id="@+id/dreamTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxWidth="460dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:shadowColor="#B3000000"
            android:shadowRadius="8" />
    </LinearLayout>
</FrameLayout>
